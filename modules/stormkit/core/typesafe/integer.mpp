    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto operator""_i128(u64 value) noexcept -> i128 {
        return static_cast<i128>(value);
    }

    /////////////////////////////////////
