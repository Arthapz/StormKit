module;

#include <stormkit/core/contract_macro.hpp>
#include <stormkit/core/platform_macro.hpp>

#ifdef STORMKIT_COMPILER_MSVC
    #include <__msvc_int128.hpp>
#endif

export module stormkit.core:typesafe.integer;

import std;

import :meta;

import :utils.contract;

namespace stormkit { inline namespace core {
    namespace meta::details {
        template<typename T>
        using WrappedValueType = typename meta::ToPlainType<T>::ValueType;

        template<typename T>
        concept IsWrappedValueType = PlainIs<T, WrappedValueType<T>>;
    } // namespace meta::details

    template<meta::IsArithmetic T>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto is_positive(const T& value) noexcept -> bool {
        if constexpr (meta::IsUnsigned<T>) return true;
        else
            return value >= 0;
    }

    template<meta::IsArithmetic T>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto is_negative(const T& value) noexcept -> bool {
        if constexpr (meta::IsSigned<T>) return value < 0;
        else
            return false;
    }
}} // namespace stormkit::core

export {
    namespace stormkit { inline namespace core {
        namespace cpp {
            using UChar     = unsigned char;
            using UShort    = unsigned short;
            using UInt      = unsigned int;
            using ULong     = unsigned long;
            using ULongLong = unsigned long long;

            using SChar    = signed char;
            using Short    = signed short;
            using Int      = signed int;
            using Long     = signed long;
            using LongLong = signed long long;

            using LongDouble = long double;
        } // namespace cpp

#define STORMKIT_ALLOW_PRIMITIVE_TYPE_IMPLICIT_CONVERSION
#ifdef STORMKIT_ALLOW_PRIMITIVE_TYPE_IMPLICIT_CONVERSION
        using u8  = std::uint8_t;
        using u16 = std::uint16_t;
        using u32 = std::uint32_t;
        using u64 = std::uint64_t;
    #ifdef __SIZEOF_INT128__
        using u128 = unsigned __int128;
    #elif defined(STORMKIT_COMPILER_MSVC)
        using u128 = std::_Unsigned128;
    #endif

        using i8  = std::int8_t;
        using i16 = std::int16_t;
        using i32 = std::int32_t;
        using i64 = std::int64_t;
    #ifdef __SIZEOF_INT128__
        using i128 = __int128;
    #elif defined(STORMKIT_COMPILER_MSVC)
        using i128 = std::_Signed128;
    #else
    #endif

        using usize   = std::size_t;
        using isize   = std::ptrdiff_t;
        using ioffset = std::ptrdiff_t;
        using uptr    = std::uintptr_t;
        using iptr    = std::intptr_t;
#else
        enum class u8 : std::uint8_t {
        };
        enum class u16 : std::uint16_t {
        };
        enum class u32 : std::uint32_t {
        };
        enum class u64 : std::uint64_t {
        };

    #ifdef __SIZEOF_INT128__
        enum class u128 : unsigned __int128 {
        };
    #elif defined(STORMKIT_COMPILER_MSVC)
        enum class u128 : std::_Unsigned128 {
        };
    #endif

        enum class i8 : std::int8_t {
        };
        enum class i16 : std::int16_t {
        };
        enum class i32 : std::int32_t {
        };
        enum class i64 : std::int64_t {
        };
    #ifdef __SIZEOF_INT128__
        enum class i128 : __int128 {
        };
    #elif defined(STORMKIT_COMPILER_MSVC)
        enum class i128 : std::_Signed128 {
        };
    #else
    #endif

        enum class usize : std::size_t {
        };
        enum class isize : std::ptrdiff_t {
        };
        enum class ioffset : std::ptrdiff_t {
        };
        enum class uptr : std::uintptr_t {
        };
        enum class iptr : std::intptr_t {
        };
#endif

        template<typename T, typename Tag, auto check_fn>
        struct CheckedValue {
            using ValueType = T;

            template<meta::PlainIs<T> U>
            constexpr CheckedValue(U&& _value) : value { std::forward<U>(_value) } {
                EXPECTS(check_fn(value));
            }

            template<meta::PlainIs<T> U>
            constexpr auto operator=(U&& _value) noexcept -> CheckedValue& {
                value = _value;
                ENSURES(check_fn(value));
                return *this;
            }

            constexpr operator T() noexcept { return value; }

            constexpr auto operator+(meta::PlainIs<ValueType> auto&& other) const noexcept
              -> CheckedValue
                requires(meta::IsArithmetic<T>);

            constexpr auto operator+(meta::PlainIs<CheckedValue> auto&& other) const noexcept
              -> CheckedValue
                requires(meta::IsArithmetic<T>);

            constexpr auto operator+=(meta::PlainIs<ValueType> auto&& other) noexcept
              -> CheckedValue&
                requires(meta::IsArithmetic<T>);

            constexpr auto operator+=(meta::PlainIs<CheckedValue> auto&& other) noexcept
              -> CheckedValue&
                requires(meta::IsArithmetic<T>);

            constexpr auto operator-(meta::PlainIs<ValueType> auto&& other) const noexcept
              -> CheckedValue
                requires(meta::IsArithmetic<T>);

            constexpr auto operator-(meta::PlainIs<CheckedValue> auto&& other) const noexcept
              -> CheckedValue
                requires(meta::IsArithmetic<T>);

            constexpr auto operator-=(meta::PlainIs<ValueType> auto&& other) noexcept
              -> CheckedValue&
                requires(meta::IsArithmetic<T>);

            constexpr auto operator-=(meta::PlainIs<CheckedValue> auto&& other) noexcept
              -> CheckedValue&
                requires(meta::IsArithmetic<T>);

            constexpr auto operator*(meta::PlainIs<ValueType> auto&& other) const noexcept
              -> CheckedValue
                requires(meta::IsArithmetic<T>);

            constexpr auto operator*(meta::PlainIs<CheckedValue> auto&& other) const noexcept
              -> CheckedValue
                requires(meta::IsArithmetic<T>);

            constexpr auto operator*=(meta::PlainIs<ValueType> auto&& other) noexcept
              -> CheckedValue&
                requires(meta::IsArithmetic<T>);

            constexpr auto operator*=(meta::PlainIs<CheckedValue> auto&& other) noexcept
              -> CheckedValue&
                requires(meta::IsArithmetic<T>);

            constexpr auto operator/(meta::PlainIs<ValueType> auto&& other) const noexcept
              -> CheckedValue
                requires(meta::IsArithmetic<T>);

            constexpr auto operator/(meta::PlainIs<CheckedValue> auto&& other) const noexcept
              -> CheckedValue
                requires(meta::IsArithmetic<T>);

            constexpr auto operator/=(meta::PlainIs<ValueType> auto&& other) noexcept
              -> CheckedValue&
                requires(meta::IsArithmetic<T>);

            constexpr auto operator/=(meta::PlainIs<CheckedValue> auto&& other) noexcept
              -> CheckedValue&
                requires(meta::IsArithmetic<T>);

            T value;
        };

        namespace meta {
            template<typename T>
            concept IsCheckedValue = IsSpecializationOfNTTP_TTV<T, CheckedValue>;
        }

        template<meta::IsCheckedValue T>
            requires(meta::IsArithmetic<typename meta::ToPlainType<T>::ValueType>)
        constexpr auto operator+(meta::PlainIs<typename meta::ToPlainType<T>::ValueType> auto&&
                                     first,
                                 T&& second) noexcept -> meta::ToPlainType<T>;

        template<meta::IsCheckedValue T>
            requires(meta::IsArithmetic<typename meta::ToPlainType<T>::ValueType>)
        constexpr auto operator-(meta::PlainIs<typename meta::ToPlainType<T>::ValueType> auto&&
                                     first,
                                 T&& second) noexcept -> meta::ToPlainType<T>;

        template<meta::IsCheckedValue T>
            requires(meta::IsArithmetic<typename meta::ToPlainType<T>::ValueType>)
        constexpr auto operator*(meta::PlainIs<typename meta::ToPlainType<T>::ValueType> auto&&
                                     first,
                                 T&& second) noexcept -> meta::ToPlainType<T>;

        template<meta::IsCheckedValue T>
            requires(meta::IsArithmetic<typename meta::ToPlainType<T>::ValueType>)
        constexpr auto operator/(meta::PlainIs<typename meta::ToPlainType<T>::ValueType> auto&&
                                     first,
                                 T&& second) noexcept -> meta::ToPlainType<T>;

        template<meta::IsFormattable T, typename Tag, auto check_fn, typename FormatContext>
        constexpr auto format_as(const CheckedValue<T, Tag, check_fn>& val, FormatContext& ctx)
          -> decltype(ctx.out());

        template<typename T>
        using Positive = CheckedValue<T, struct PositiveTag, is_positive<T>>;

        template<typename T>
        using Negative = CheckedValue<T, struct NegativeTag, is_negative<T>>;

        [[nodiscard]]
        constexpr auto operator""_i8(u64) noexcept -> i8;
        [[nodiscard]]
        constexpr auto operator""_i16(u64) noexcept -> i16;
        [[nodiscard]]
        constexpr auto operator""_i32(u64) noexcept -> i32;
        [[nodiscard]]
        constexpr auto operator""_i64(u64) noexcept -> i64;
        [[nodiscard]]
        constexpr auto operator""_i128(u64) noexcept -> i128;

        [[nodiscard]]
        constexpr auto operator""_u8(u64) noexcept -> u8;
        [[nodiscard]]
        constexpr auto operator""_u16(u64) noexcept -> u16;
        [[nodiscard]]
        constexpr auto operator""_u32(u64) noexcept -> u32;
        [[nodiscard]]
        constexpr auto operator""_u64(u64) noexcept -> u64;
        [[nodiscard]]
        constexpr auto operator""_u128(u64) noexcept -> u128;

        [[nodiscard]]
        constexpr auto operator""_usize(u64) noexcept -> usize;
        [[nodiscard]]
        constexpr auto operator""_isize(u64) noexcept -> isize;
        [[nodiscard]]
        constexpr auto operator""_ioffset(u64) noexcept -> ioffset;
        [[nodiscard]]
        constexpr auto operator""_uptr(u64) noexcept -> uptr;
        [[nodiscard]]
        constexpr auto operator""_iptr(u64) noexcept -> iptr;
    }} // namespace stormkit::core
}

namespace stormkit { inline namespace core {
    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto CheckedValue<T, Tag, check_fn>::operator+(meta::PlainIs<ValueType> auto&& other)
      const noexcept -> CheckedValue
        requires(meta::IsArithmetic<T>)
    {
        return { value + std::forward<decltype(other)>(other) };
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto CheckedValue<T, Tag, check_fn>::operator+(meta::PlainIs<CheckedValue> auto&&
                                                               other) const noexcept -> CheckedValue
        requires(meta::IsArithmetic<T>)
    {
        return operator+(std::forward_like<decltype(other)>(other.value));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE
    constexpr auto CheckedValue<T, Tag, check_fn>::operator+=(meta::PlainIs<ValueType> auto&&
                                                                other) noexcept -> CheckedValue&
        requires(meta::IsArithmetic<T>)
    {
        value += std::forward<decltype(other)>(other);
        return *this;
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE
    constexpr auto CheckedValue<T, Tag, check_fn>::operator+=(meta::PlainIs<CheckedValue> auto&&
                                                                other) noexcept -> CheckedValue&
        requires(meta::IsArithmetic<T>)
    {
        return operator+=(std::forward_like<decltype(other)>(other.value));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto CheckedValue<T, Tag, check_fn>::operator-(meta::PlainIs<ValueType> auto&& other)
      const noexcept -> CheckedValue
        requires(meta::IsArithmetic<T>)
    {
        return { value - std::forward<decltype(other)>(other) };
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto CheckedValue<T, Tag, check_fn>::operator-(meta::PlainIs<CheckedValue> auto&&
                                                               other) const noexcept -> CheckedValue
        requires(meta::IsArithmetic<T>)
    {
        return operator-(std::forward_like<decltype(other)>(other.value));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE
    constexpr auto CheckedValue<T, Tag, check_fn>::operator-=(meta::PlainIs<ValueType> auto&&
                                                                other) noexcept -> CheckedValue&
        requires(meta::IsArithmetic<T>)
    {
        value -= std::forward<decltype(other)>(other);
        return *this;
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE
    constexpr auto CheckedValue<T, Tag, check_fn>::operator-=(meta::PlainIs<CheckedValue> auto&&
                                                                other) noexcept -> CheckedValue&
        requires(meta::IsArithmetic<T>)
    {
        return operator-=(std::forward_like<decltype(other)>(other.value));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto CheckedValue<T, Tag, check_fn>::operator*(meta::PlainIs<ValueType> auto&& other)
      const noexcept -> CheckedValue
        requires(meta::IsArithmetic<T>)
    {
        return { value * std::forward<decltype(other)>(other) };
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto CheckedValue<T, Tag, check_fn>::operator*(meta::PlainIs<CheckedValue> auto&&
                                                               other) const noexcept -> CheckedValue
        requires(meta::IsArithmetic<T>)
    {
        return operator*(std::forward_like<decltype(other)>(other.value));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE
    constexpr auto CheckedValue<T, Tag, check_fn>::operator*=(meta::PlainIs<ValueType> auto&&
                                                                other) noexcept -> CheckedValue&
        requires(meta::IsArithmetic<T>)
    {
        value *= std::forward<decltype(other)>(other);
        return *this;
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE
    constexpr auto CheckedValue<T, Tag, check_fn>::operator*=(meta::PlainIs<CheckedValue> auto&&
                                                                other) noexcept -> CheckedValue&
        requires(meta::IsArithmetic<T>)
    {
        return operator*=(std::forward_like<decltype(other)>(other.value));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto CheckedValue<T, Tag, check_fn>::operator/(meta::PlainIs<ValueType> auto&& other)
      const noexcept -> CheckedValue
        requires(meta::IsArithmetic<T>)
    {
        return { value / std::forward<decltype(other)>(other) };
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto CheckedValue<T, Tag, check_fn>::operator/(meta::PlainIs<CheckedValue> auto&&
                                                               other) const noexcept -> CheckedValue
        requires(meta::IsArithmetic<T>)
    {
        return operator/(std::forward_like<decltype(other)>(other.value));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE
    constexpr auto CheckedValue<T, Tag, check_fn>::operator/=(meta::PlainIs<ValueType> auto&&
                                                                other) noexcept -> CheckedValue&
        requires(meta::IsArithmetic<T>)
    {
        value /= std::forward<decltype(other)>(other);
        return *this;
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, typename Tag, auto check_fn>
    STORMKIT_FORCE_INLINE
    constexpr auto CheckedValue<T, Tag, check_fn>::operator/=(meta::PlainIs<CheckedValue> auto&&
                                                                other) noexcept -> CheckedValue&
        requires(meta::IsArithmetic<T>)
    {
        return operator/=(std::forward_like<decltype(other)>(other.value));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsCheckedValue T>
        requires(meta::IsArithmetic<typename meta::ToPlainType<T>::ValueType>)
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto operator+(meta::PlainIs<typename meta::ToPlainType<T>::ValueType> auto&& first,
                             T&& second) noexcept -> meta::ToPlainType<T> {
        return std::forward<T>(second).operator+(std::forward<decltype(first)>(first));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsCheckedValue T>
        requires(meta::IsArithmetic<typename meta::ToPlainType<T>::ValueType>)
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto operator-(meta::PlainIs<typename meta::ToPlainType<T>::ValueType> auto&& first,
                             T&& second) noexcept -> meta::ToPlainType<T> {
        return std::forward<T>(second).operator-(std::forward<decltype(first)>(first));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsCheckedValue T>
        requires(meta::IsArithmetic<typename meta::ToPlainType<T>::ValueType>)
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto operator*(meta::PlainIs<typename meta::ToPlainType<T>::ValueType> auto&& first,
                             T&& second) noexcept -> meta::ToPlainType<T> {
        return std::forward<T>(second).operator*(std::forward<decltype(first)>(first));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsCheckedValue T>
        requires(meta::IsArithmetic<typename meta::ToPlainType<T>::ValueType>)
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto operator/(meta::PlainIs<typename meta::ToPlainType<T>::ValueType> auto&& first,
                             T&& second) noexcept -> meta::ToPlainType<T> {
        return std::forward<T>(second).operator/(std::forward<decltype(first)>(first));
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsFormattable T, typename Tag, auto check_fn, typename FormatContext>
        STORMKIT_FORCE_INLINE
    constexpr auto format_as(const CheckedValue<T, Tag, check_fn>& val, FormatContext& ctx)
      -> decltype(ctx.out()) {
        auto&& out = ctx.out();
        return std::format_to(out, "{}", val.value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto operator""_i8(u64 value) noexcept -> i8 {
        return static_cast<i8>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto operator""_i16(u64 value) noexcept -> i16 {
        return static_cast<i16>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto operator""_i32(u64 value) noexcept -> i32 {
        return static_cast<i32>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto operator""_i64(u64 value) noexcept -> i64 {
