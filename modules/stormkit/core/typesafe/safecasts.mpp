module;

#include <stormkit/core/platform_macro.hpp>

export module stormkit.core:typesafe.safecasts;

import std;

import :meta;

import :typesafe.boolean;
import :typesafe.floating_point;
import :typesafe.integer;

import :utils.contract;

export {
    namespace stormkit { inline namespace core {
        template<typename... Args>
        [[nodiscard]]
        constexpr auto is_equal_impl(Args...) noexcept -> bool
          = delete
#if defined(STORMKIT_COMPILER_MSVC)
          ;
#else
          ("No is value queryier for theses arguments");
#endif

        template<typename T, typename... Args>
        [[nodiscard]]
        constexpr auto is_impl(Args...) noexcept -> bool
          = delete
#if defined(STORMKIT_COMPILER_MSVC)
          ;
#else
          ("No is type queryier for these arguments");
#endif

        template<typename T, typename... Args>
        [[nodiscard]]
        constexpr auto as_impl(Args..., const std::source_location&) noexcept -> T
          = delete
#if defined(STORMKIT_COMPILER_MSVC)
          ;
#else
          ("No as caster for these arguments");
#endif

        template<typename T, typename... Args>
        [[nodiscard]]
        constexpr auto narrow_impl(Args...) noexcept -> T
          = delete
#if defined(STORMKIT_COMPILER_MSVC)
          ;
#else
          ("No narrow caster for these arguments");
#endif

        struct Underlying {};

        struct Equal {};

        namespace meta {
            template<typename... Args>
            concept HasIsValueQueryier = requires(Args&&... args) {
                { is_equal_impl<Args...>(std::forward<Args>(args)...) } -> IsBooleanTestable;
            };

            template<typename T, typename U>
            concept HasIsTypeQueryier = requires(U&& value) {
                { is_impl<T>(std::forward<U>(value)) } -> IsBooleanTestable;
            };

            template<typename T, typename U>
            concept HasAsCaster = requires(U&& value) { as_impl<T>(std::forward<U>(value)); };

            template<typename T, typename U>
            concept HasNarrowCaster = requires(U&& value) {
                { narrow_impl<T>(std::forward<U>(value)) } -> Is<T>;
            };
        } // namespace meta

        struct IsEqualFn final {
            template<typename... Args>
            [[nodiscard]]
            static constexpr auto operator()(const Args&... value) noexcept -> bool;
        };

        template<typename T>
        struct IsFn final {
            template<typename U>
            [[nodiscard]]
            static constexpr auto operator()(const U& value) noexcept -> bool;
        };

        template<>
        struct IsFn<Equal> final {
            template<typename... Args>
            [[nodiscard]]
            static constexpr auto operator()(const Args&... args) noexcept -> bool;
        };

        template<typename T>
        inline constexpr auto is = IsFn<T> {};

        inline constexpr auto is_equal = IsEqualFn {};

        template<typename T>
        struct AsFn final {
            template<typename U>
            [[nodiscard]]
            static constexpr auto operator()(U&&                         value,
                                             const std::source_location& location = std::
                                               source_location::current()) noexcept
              -> decltype(auto);
        };

        template<typename T>
        inline constexpr auto as = AsFn<T> {};

        template<typename T>
        struct NarrowFn final {
            template<typename U>
            [[nodiscard]]
            static constexpr auto operator()(U&& value) noexcept -> decltype(auto);
        };

        template<typename T>
        inline constexpr auto narrow = NarrowFn<T> {};

        ////////////////////////////////////////////////////////////////////
        ///                      ARITHMETIC                              ///
        ////////////////////////////////////////////////////////////////////
        template<meta::IsFloatingPoint T>
        [[nodiscard]]
        constexpr auto is_equal_impl(T first, T second, T epsilon = EPSILON<T>) noexcept -> bool;

        template<meta::IsFloatingPoint T, meta::IsFloatingPoint U>
        [[nodiscard]]
        constexpr auto is_equal_impl(T first, U second, auto epsilon = EPSILON<U>) noexcept -> bool;

        template<meta::IsFloatingPoint T, meta::IsIntegral U>
        [[nodiscard]]
        constexpr auto is_equal_impl(T first, U second, T epsilon = EPSILON<T>) noexcept -> bool;

        template<meta::IsIntegral T, meta::IsFloatingPoint U>
        [[nodiscard]]
        constexpr auto is_equal_impl(T first, U second, U epsilon = EPSILON<U>) noexcept -> bool;

        template<meta::IsIntegral T, meta::IsIntegral U>
        [[nodiscard]]
        constexpr auto is_equal_impl(T first, U second) noexcept -> bool;

        template<meta::IsEnumeration T>
        [[nodiscard]]
        constexpr auto is_equal_impl(T first, T second) noexcept -> bool;

        template<meta::ConvertibleTo<std::string_view> T, meta::ConvertibleTo<std::string_view> U>
        [[nodiscard]]
        constexpr auto is_equal_impl(T&& first, U&& second) noexcept -> bool;

        template<meta::IsArithmetic T, meta::IsArithmetic U>
        [[nodiscard]]
        constexpr auto as_impl(U value, const std::source_location&) noexcept -> T;

        template<meta::IsArithmetic T, meta::IsArithmetic U>
        [[nodiscard]]
        constexpr auto narrow_impl(U value) noexcept -> T;

        ////////////////////////////////////////////////////////////////////
        ///                           BYTES                              ///
        ////////////////////////////////////////////////////////////////////
        template<meta::IsByte T, meta::IsByte U>
        [[nodiscard]]
        constexpr auto is_impl(T first, T second) noexcept -> bool;

        template<meta::IsByte T, meta::IsArithmetic U>
        [[nodiscard]]
        constexpr auto as_impl(U value, const std::source_location&) noexcept -> T;

        template<meta::IsArithmetic T, meta::IsByte U>
        [[nodiscard]]
        constexpr auto as_impl(U value, const std::source_location&) noexcept -> T;

        template<meta::IsArithmetic T, meta::IsByte U>
        [[nodiscard]]
        constexpr auto narrow_impl(U value) noexcept -> T;

        template<meta::IsByte T, meta::IsArithmetic U>
        [[nodiscard]]
        constexpr auto narrow_impl(U value) noexcept -> T;

        ////////////////////////////////////////////////////////////////////
        ///                       ENUMERATION                            ///
        ////////////////////////////////////////////////////////////////////
        template<meta::IsEnumeration T, meta::IsEnumeration U>
            requires(meta::Same<T, U>)
        [[nodiscard]]
        constexpr auto is_impl(T first, U second) noexcept -> bool;

        template<typename T, meta::IsEnumeration U>
            requires(meta::Same<T, Underlying>)
        [[nodiscard]]
        constexpr auto as_impl(U value, const std::source_location&) noexcept
          -> meta::UnderlyingType<U>;

        template<meta::IsEnumeration T, meta::IsArithmetic U>
            requires(meta::Same<meta::UnderlyingType<T>, U>)
        [[nodiscard]]
        constexpr auto as_impl(U value, const std::source_location&) noexcept -> T;

        template<meta::IsArithmetic T, meta::IsEnumeration U>
            requires(meta::Same<T, meta::UnderlyingType<U>>)
        [[nodiscard]]
        constexpr auto as_impl(U value, const std::source_location&) noexcept -> T;

        template<meta::IsEnumeration T, meta::IsEnumeration U>
        [[nodiscard]]
        constexpr auto narrow_impl(U value) noexcept -> T;

        template<meta::IsArithmetic T, meta::IsEnumeration U>
        [[nodiscard]]
        constexpr auto narrow_impl(U value) noexcept -> T;

        template<meta::IsEnumeration T, meta::IsArithmetic U>
        [[nodiscard]]
        constexpr auto narrow_impl(U value) noexcept -> T;

        ////////////////////////////////////////////////////////////////////
        ///                          STL                                 ///
        ////////////////////////////////////////////////////////////////////
        template<typename T, meta::IsVariantType U>
        [[nodiscard]]
        constexpr auto is_impl(const U& value) noexcept -> bool;

        template<typename T, meta::IsVariantType U>
        [[nodiscard]]
        constexpr auto as_impl(U&& value, const std::source_location&) noexcept
          -> meta::ForwardLike<U, T>;
    }} // namespace stormkit::core
}

////////////////////////////////////////////////////////////////////
///                      IMPLEMENTATION                          ///
////////////////////////////////////////////////////////////////////

namespace stormkit { inline namespace core {
    /////////////////////////////////////
    /////////////////////////////////////
    template<typename To, typename From>
        requires((meta::IsArithmetic<To> or meta::IsByte<To>)
                 and (meta::IsArithmetic<From> or meta::IsByte<From>))
    constexpr auto isSafeNarrowing(const From& from) noexcept -> Boolean {
        if constexpr ((meta::IsArithmetic<From> and meta::IsByte<To>)
                      or (meta::IsByte<From> and meta::IsArithmetic<To>))
            return (static_cast<From>(static_cast<To>(from)) == from);
        else if constexpr (meta::IsArithmetic<From> and meta::IsArithmetic<To>)
            return (static_cast<From>(static_cast<To>(from)) == from)
                   or (meta::IsSigned<To> != meta::IsUnsigned<From>
                       and ((static_cast<To>(from) < To {}) == (from < From {})));
        std::unreachable();
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename... Args>
    STORMKIT_FORCE_INLINE
    constexpr auto IsEqualFn::operator()(const Args&... values) noexcept -> bool {
        return is_equal_impl(values...);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename... Args>
    STORMKIT_FORCE_INLINE
    constexpr auto IsFn<Equal>::operator()(const Args&... values) noexcept -> bool {
        return is_equal(values...);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T>
    template<typename U>
    STORMKIT_FORCE_INLINE
    constexpr auto IsFn<T>::operator()(const U& value) noexcept -> bool {
        return is_impl<T>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T>
    template<typename U>
    STORMKIT_FORCE_INLINE
    constexpr auto AsFn<T>::operator()(U&& value, const std::source_location& location) noexcept
      -> decltype(auto) {
        return as_impl<T>(std::forward<U>(value), location);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T>
    template<typename U>
    STORMKIT_FORCE_INLINE
    constexpr auto NarrowFn<T>::operator()(U&& value) noexcept -> decltype(auto) {
        return narrow_impl<T>(std::forward<U>(value));
    }

    ////////////////////////////////////////////////////////////////////
    ///                      ARITHMETIC                              ///
    ////////////////////////////////////////////////////////////////////
    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsFloatingPoint T>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto is_equal_impl(T first, T second, T epsilon) noexcept -> bool {
        const auto diff = std::abs(first - second);
        const auto a    = std::abs(first);
        const auto b    = std::abs(second);
        const auto ab   = (a > b) ? b : a;
        return diff <= (ab * epsilon);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsFloatingPoint T, meta::IsFloatingPoint U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto is_equal_impl(T first, U second, auto epsilon) noexcept -> bool {
        const auto diff = std::abs(first - second);
        const auto a    = std::abs(first);
        const auto b    = std::abs(second);
        const auto ab   = (a > b) ? b : a;
        return diff <= (ab * epsilon);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsFloatingPoint T, meta::IsIntegral U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto is_equal_impl(T first, U second, T epsilon) noexcept -> bool {
        return is_equal_impl(first, as<T>(second), epsilon);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsIntegral T, meta::IsFloatingPoint U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto is_equal_impl(T first, U second, U epsilon) noexcept -> bool {
        return is_equal_impl(as<U>(first), second, epsilon);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsIntegral T, meta::IsIntegral U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto is_equal_impl(T first, U second) noexcept -> bool {
        if constexpr (meta::IsNarrowing<T, meta::ToPlainType<U>>) {
            using SafeT        = meta::SafeNarrowHelperType<T, U>;
            const auto _first  = as<SafeT>(first);
            const auto _second = as<SafeT>(second);
            return _first == _second;
        } else
            return first == second;
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsEnumeration T>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto is_equal_impl(T first, T second) noexcept -> bool {
        return first == second;
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::ConvertibleTo<std::string_view> T, meta::ConvertibleTo<std::string_view> U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto is_equal_impl(T&& first, U&& second) noexcept -> bool {
        return std::string_view { std::forward<T>(first) }
               == std::string_view { std::forward<U>(second) };
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<stormkit::meta::IsArithmetic T, stormkit::meta::IsArithmetic U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto as_impl(U value, const std::source_location& location) noexcept -> T {
        if constexpr (meta::IsNarrowing<T, meta::ToPlainType<U>>)
            expects(isSafeNarrowing<T>(value),
                    "Lossy narrowing detected, please use narrow() only if you really "
                    "want unsafe "
                    "narrowing",
                    location);
        return static_cast<T>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<stormkit::meta::IsArithmetic T, stormkit::meta::IsArithmetic U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto narrow_impl(U value) noexcept -> T {
        return static_cast<T>(value);
    }

    ////////////////////////////////////////////////////////////////////
    ///                      BYTES                              ///
    ////////////////////////////////////////////////////////////////////
    /////////////////////////////////////
    /////////////////////////////////////
    template<stormkit::meta::IsByte T, stormkit::meta::IsArithmetic U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto as_impl(U value, const std::source_location& location) noexcept -> T {
        if constexpr (meta::IsNarrowing<T, meta::ToPlainType<U>>)
            expects(isSafeNarrowing<T>(value),
                    "Lossy narrowing detected, please use narrow() only if you really "
                    "want unsafe "
                    "narrowing",
                    location);
        return static_cast<T>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<stormkit::meta::IsArithmetic T, stormkit::meta::IsByte U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto as_impl(U value, const std::source_location& location) noexcept -> T {
        if constexpr (meta::IsNarrowing<T, meta::ToPlainType<U>>)
            expects(isSafeNarrowing<T>(value),
                    "Lossy narrowing detected, please use narrow() only if you really "
                    "want unsafe "
                    "narrowing",
                    location);
        return static_cast<T>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<stormkit::meta::IsArithmetic T, stormkit::meta::IsByte U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto narrow_impl(U value) noexcept -> T {
        return static_cast<T>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<stormkit::meta::IsByte T, stormkit::meta::IsArithmetic U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto narrow_impl(U value) noexcept -> T {
        return static_cast<T>(value);
    }

    ////////////////////////////////////////////////////////////////////
    ///                       ENUMERATION                            ///
    ////////////////////////////////////////////////////////////////////
    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsEnumeration T, meta::IsEnumeration U>
        requires(meta::Same<T, U>)
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto is_impl(T first, U second) noexcept -> bool {
        return first == second;
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, meta::IsEnumeration U>
        requires(meta::Same<T, Underlying>)
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto as_impl(U value, const std::source_location&) noexcept
      -> meta::UnderlyingType<U> {
        // TODO WHEN REFLEXION IS IMPLEMENTED, CHECK IF `value` IS A VALID ENUMERATION VALUE
        return as<meta::UnderlyingType<U>>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsEnumeration T, meta::IsArithmetic U>
        requires(meta::Same<meta::UnderlyingType<T>, U>)
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto as_impl(U value, const std::source_location&) noexcept -> T {
        // TODO WHEN REFLEXION IS IMPLEMENTED, CHECK IF `value` IS A VALID ENUMERATION VALUE
        return narrow<U>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsArithmetic T, meta::IsEnumeration U>
        requires(meta::Same<T, meta::UnderlyingType<U>>)
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto as_impl(U value, const std::source_location&) noexcept -> T {
        return narrow<meta::UnderlyingType<U>>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsEnumeration T, meta::IsEnumeration U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto narrow_impl(U value) noexcept -> T {
        return static_cast<T>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsArithmetic T, meta::IsEnumeration U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto narrow_impl(U value) noexcept -> T {
        return static_cast<T>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<meta::IsEnumeration T, meta::IsArithmetic U>
    STORMKIT_FORCE_INLINE STORMKIT_CONST STORMKIT_INTRINSIC
    constexpr auto narrow_impl(U value) noexcept -> T {
        return static_cast<T>(value);
    }

    ////////////////////////////////////////////////////////////////////
    ///                          STL                                 ///
    ////////////////////////////////////////////////////////////////////
    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, meta::IsVariantType U>
    STORMKIT_FORCE_INLINE
    constexpr auto is_impl(const U& value) noexcept -> bool {
        return std::holds_alternative<T>(value);
    }

    /////////////////////////////////////
    /////////////////////////////////////
    template<typename T, meta::IsVariantType U>
    STORMKIT_FORCE_INLINE
    constexpr auto as_impl(U&& value, const std::source_location&) noexcept
      -> meta::ForwardLike<U, T> {
        return std::forward_like<U>(std::get<T>(value));
    }

#define IS_EQUAL_INSTANCIATE(t1, t2) template auto is_equal_impl<t1, t2>(t1, t2) noexcept -> bool;
#define IS_EQUAL_INSTANCIATE_F1(t1, t2) \
    template auto is_equal_impl<t1, t2, t1>(t1, t2, t1) noexcept -> bool;
#define IS_EQUAL_INSTANCIATE_F2(t1, t2) template auto is_equal_impl(t1, t2, t2) noexcept -> bool

    IS_EQUAL_INSTANCIATE(u8, u8);
    IS_EQUAL_INSTANCIATE(u8, i8);
    IS_EQUAL_INSTANCIATE(u8, u16);
    IS_EQUAL_INSTANCIATE(u8, i16);
    IS_EQUAL_INSTANCIATE(u8, u32);
    IS_EQUAL_INSTANCIATE(u8, i32);
    IS_EQUAL_INSTANCIATE(u8, u64);
    IS_EQUAL_INSTANCIATE(u8, i64);
    IS_EQUAL_INSTANCIATE(u8, u128);
    IS_EQUAL_INSTANCIATE(u8, i128);
    IS_EQUAL_INSTANCIATE_F2(u8, f32);
    IS_EQUAL_INSTANCIATE_F2(u8, f64);
    IS_EQUAL_INSTANCIATE(u8, std::byte);

    IS_EQUAL_INSTANCIATE(i8, u8);
    IS_EQUAL_INSTANCIATE(i8, i8);
    IS_EQUAL_INSTANCIATE(i8, u16);
    IS_EQUAL_INSTANCIATE(i8, i16);
    IS_EQUAL_INSTANCIATE(i8, u32);
    IS_EQUAL_INSTANCIATE(i8, i32);
    IS_EQUAL_INSTANCIATE(i8, u64);
    IS_EQUAL_INSTANCIATE(i8, i64);
    IS_EQUAL_INSTANCIATE(i8, u128);
    IS_EQUAL_INSTANCIATE(i8, i128);
    IS_EQUAL_INSTANCIATE_F2(i8, f32);
    IS_EQUAL_INSTANCIATE_F2(i8, f64);
    IS_EQUAL_INSTANCIATE(i8, std::byte);

    IS_EQUAL_INSTANCIATE(u16, u8);
    IS_EQUAL_INSTANCIATE(u16, i8);
    IS_EQUAL_INSTANCIATE(u16, u16);
    IS_EQUAL_INSTANCIATE(u16, i16);
    IS_EQUAL_INSTANCIATE(u16, u32);
    IS_EQUAL_INSTANCIATE(u16, i32);
    IS_EQUAL_INSTANCIATE(u16, u64);
    IS_EQUAL_INSTANCIATE(u16, i64);
    IS_EQUAL_INSTANCIATE(u16, u128);
    IS_EQUAL_INSTANCIATE(u16, i128);
    IS_EQUAL_INSTANCIATE_F2(u16, f32);
    IS_EQUAL_INSTANCIATE_F2(u16, f64);
    IS_EQUAL_INSTANCIATE(u16, std::byte);

    IS_EQUAL_INSTANCIATE(i16, u8);
    IS_EQUAL_INSTANCIATE(i16, i8);
    IS_EQUAL_INSTANCIATE(i16, u16);
    IS_EQUAL_INSTANCIATE(i16, i16);
    IS_EQUAL_INSTANCIATE(i16, u32);
    IS_EQUAL_INSTANCIATE(i16, i32);
    IS_EQUAL_INSTANCIATE(i16, u64);
    IS_EQUAL_INSTANCIATE(i16, i64);
    IS_EQUAL_INSTANCIATE(i16, u128);
    IS_EQUAL_INSTANCIATE(i16, i128);
    IS_EQUAL_INSTANCIATE_F2(i16, f32);
    IS_EQUAL_INSTANCIATE_F2(i16, f64);
    IS_EQUAL_INSTANCIATE(i16, std::byte);

    IS_EQUAL_INSTANCIATE(u32, u8);
    IS_EQUAL_INSTANCIATE(u32, i8);
    IS_EQUAL_INSTANCIATE(u32, u16);
    IS_EQUAL_INSTANCIATE(u32, i16);
    IS_EQUAL_INSTANCIATE(u32, u32);
    IS_EQUAL_INSTANCIATE(u32, i32);
    IS_EQUAL_INSTANCIATE(u32, u64);
    IS_EQUAL_INSTANCIATE(u32, i64);
    IS_EQUAL_INSTANCIATE(u32, u128);
    IS_EQUAL_INSTANCIATE(u32, i128);
    IS_EQUAL_INSTANCIATE_F2(u32, f32);
    IS_EQUAL_INSTANCIATE_F2(u32, f64);
    IS_EQUAL_INSTANCIATE(u32, std::byte);

    IS_EQUAL_INSTANCIATE(i32, u8);
    IS_EQUAL_INSTANCIATE(i32, i8);
    IS_EQUAL_INSTANCIATE(i32, u16);
    IS_EQUAL_INSTANCIATE(i32, i16);
    IS_EQUAL_INSTANCIATE(i32, u32);
    IS_EQUAL_INSTANCIATE(i32, i32);
    IS_EQUAL_INSTANCIATE(i32, u64);
    IS_EQUAL_INSTANCIATE(i32, i64);
    IS_EQUAL_INSTANCIATE(i32, u128);
    IS_EQUAL_INSTANCIATE(i32, i128);
    IS_EQUAL_INSTANCIATE_F2(i32, f32);
    IS_EQUAL_INSTANCIATE_F2(i32, f64);
    IS_EQUAL_INSTANCIATE(i32, std::byte);

    IS_EQUAL_INSTANCIATE(u64, u8);
    IS_EQUAL_INSTANCIATE(u64, i8);
    IS_EQUAL_INSTANCIATE(u64, u16);
    IS_EQUAL_INSTANCIATE(u64, i16);
    IS_EQUAL_INSTANCIATE(u64, u32);
    IS_EQUAL_INSTANCIATE(u64, i32);
    IS_EQUAL_INSTANCIATE(u64, u64);
    IS_EQUAL_INSTANCIATE(u64, i64);
    IS_EQUAL_INSTANCIATE(u64, u128);
    IS_EQUAL_INSTANCIATE(u64, i128);
    IS_EQUAL_INSTANCIATE_F2(u64, f32);
    IS_EQUAL_INSTANCIATE_F2(u64, f64);
    IS_EQUAL_INSTANCIATE(u64, std::byte);

    IS_EQUAL_INSTANCIATE(i64, u8);
    IS_EQUAL_INSTANCIATE(i64, i8);
    IS_EQUAL_INSTANCIATE(i64, u16);
    IS_EQUAL_INSTANCIATE(i64, i16);
    IS_EQUAL_INSTANCIATE(i64, u32);
    IS_EQUAL_INSTANCIATE(i64, i32);
    IS_EQUAL_INSTANCIATE(i64, u64);
    IS_EQUAL_INSTANCIATE(i64, i64);
    IS_EQUAL_INSTANCIATE(i64, u128);
    IS_EQUAL_INSTANCIATE(i64, i128);
    IS_EQUAL_INSTANCIATE_F2(i64, f32);
    IS_EQUAL_INSTANCIATE_F2(i64, f64);
    IS_EQUAL_INSTANCIATE(i64, std::byte);

    IS_EQUAL_INSTANCIATE(u128, u8);
    IS_EQUAL_INSTANCIATE(u128, i8);
    IS_EQUAL_INSTANCIATE(u128, u16);
    IS_EQUAL_INSTANCIATE(u128, i16);
    IS_EQUAL_INSTANCIATE(u128, u32);
    IS_EQUAL_INSTANCIATE(u128, i32);
    IS_EQUAL_INSTANCIATE(u128, u64);
