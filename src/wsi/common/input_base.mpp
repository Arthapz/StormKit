module;

#include <stormkit/core/platform_macro.hpp>

export module stormkit.wsi:common.input_base;

import std;

import stormkit.core;
import stormkit.wsi;

import :mouse;
import :keyboard;

export namespace stormkit::wsi::common {
    constexpr auto as_index(MouseButton button) noexcept -> usize;
    constexpr auto as_index(Key key) noexcept -> usize;

    enum class KeyState : u8 {
        UP = 0,
        DOWN,
    };

    struct KeyboardState {
        u8   id;
        bool key_repeat = false;

        std::array<KeyState, 102> keys = filled_with<102>(KeyState::UP);
    };

    enum class ButtonState : u8 {
        UP = 0,
        DOWN,
    };

    struct MouseState {
        u8   id;
        bool hidden   = false;
        bool locked   = false;
        bool relative = false;
        bool confined = false;

        math::vec2u locked_at     = {};
        math::vec2u last_position = {};

        std::array<ButtonState, 15> buttons = filled_with<15>(ButtonState::UP);
    };
} // namespace stormkit::wsi::common

////////////////////////////////////////////////////////////////////
///                      IMPLEMENTATION                          ///
////////////////////////////////////////////////////////////////////

namespace stormkit::wsi::common {
    ////////////////////////////////////////
    ////////////////////////////////////////
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto as_index(MouseButton button) noexcept -> usize {
        switch (button) {
            case MouseButton::LEFT: return 0;
            case MouseButton::RIGHT: return 1;
            case MouseButton::MIDDLE: return 2;
            case MouseButton::BUTTON_1: return 3;
            case MouseButton::BUTTON_2: return 4;
            case MouseButton::BUTTON_3: return 5;
            case MouseButton::BUTTON_4: return 6;
            case MouseButton::BUTTON_5: return 7;
            case MouseButton::BUTTON_6: return 8;
            case MouseButton::BUTTON_7: return 9;
            case MouseButton::BUTTON_8: return 10;
            case MouseButton::BUTTON_9: return 11;
            case MouseButton::BUTTON_10: return 12;
            case MouseButton::BUTTON_11: return 13;
            case MouseButton::BUTTON_12: return 14;
            default: break;
        }

        std::unreachable();
    }

    ////////////////////////////////////////
    ////////////////////////////////////////
    STORMKIT_FORCE_INLINE STORMKIT_CONST
    constexpr auto as_index(Key key) noexcept -> usize {
        switch (key) {
            case Key::A: return 0;
            case Key::B: return 1;
            case Key::C: return 2;
            case Key::D: return 3;
            case Key::E: return 4;
            case Key::F: return 5;
            case Key::G: return 6;
            case Key::H: return 7;
            case Key::I: return 8;
            case Key::J: return 9;
            case Key::K: return 10;
            case Key::L: return 11;
            case Key::M: return 12;
            case Key::N: return 13;
            case Key::O: return 14;
            case Key::P: return 15;
            case Key::Q: return 16;
            case Key::R: return 17;
            case Key::S: return 18;
            case Key::T: return 19;
            case Key::U: return 20;
            case Key::V: return 21;
            case Key::W: return 22;
            case Key::X: return 23;
            case Key::Y: return 24;
            case Key::Z: return 25;
            case Key::NUM_0: return 26;
            case Key::NUM_1: return 27;
            case Key::NUM_2: return 28;
            case Key::NUM_3: return 29;
            case Key::NUM_4: return 30;
            case Key::NUM_5: return 31;
            case Key::NUM_6: return 32;
            case Key::NUM_7: return 33;
            case Key::NUM_8: return 34;
            case Key::NUM_9: return 35;
            case Key::ESCAPE: return 36;
            case Key::L_CONTROL: return 37;
            case Key::L_SHIFT: return 38;
            case Key::L_ALT: return 39;
            case Key::L_SYSTEM: return 40;
            case Key::R_CONTROL: return 41;
            case Key::R_SHIFT: return 42;
            case Key::R_ALT: return 43;
            case Key::R_SYSTEM: return 44;
            case Key::MENU: return 45;
            case Key::L_BRACKET: return 46;
            case Key::R_BRACKET: return 47;
            case Key::SEMI_COLON: return 48;
            case Key::COMMA: return 49;
            case Key::PERIOD: return 50;
            case Key::QUOTE: return 51;
            case Key::SLASH: return 52;
            case Key::BACK_SLASH: return 53;
            case Key::TILDE: return 54;
            case Key::EQUAL: return 55;
            case Key::HYPHEN: return 56;
            case Key::SPACE: return 57;
            case Key::ENTER: return 58;
            case Key::BACK_SPACE: return 59;
            case Key::TAB: return 60;
            case Key::PAGE_UP: return 61;
            case Key::PAGE_DOWN: return 62;
            case Key::BEGIN: return 63;
            case Key::END: return 64;
            case Key::HOME: return 65;
            case Key::INSERT: return 66;
            case Key::DELETE: return 67;
            case Key::ADD: return 68;
            case Key::SUBSTRACT: return 69;
            case Key::MULTIPLY: return 70;
            case Key::DIVIDE: return 71;
            case Key::LEFT: return 72;
            case Key::RIGHT: return 73;
            case Key::UP: return 74;
            case Key::DOWN: return 75;
            case Key::NUMPAD_0: return 76;
            case Key::NUMPAD_1: return 77;
            case Key::NUMPAD_2: return 78;
            case Key::NUMPAD_3: return 79;
            case Key::NUMPAD_4: return 80;
            case Key::NUMPAD_5: return 81;
            case Key::NUMPAD_6: return 82;
            case Key::NUMPAD_7: return 83;
            case Key::NUMPAD_8: return 84;
            case Key::NUMPAD_9: return 85;
            case Key::F1: return 86;
            case Key::F2: return 87;
            case Key::F3: return 88;
            case Key::F4: return 89;
            case Key::F5: return 90;
            case Key::F6: return 91;
            case Key::F7: return 92;
            case Key::F8: return 93;
            case Key::F9: return 94;
            case Key::F10: return 95;
            case Key::F11: return 96;
            case Key::F12: return 97;
            case Key::F13: return 98;
            case Key::F14: return 99;
            case Key::F15: return 100;
            case Key::PAUSE: return 101;
            default: break;
        }

        std::unreachable();
    }
} // namespace stormkit::wsi::common
